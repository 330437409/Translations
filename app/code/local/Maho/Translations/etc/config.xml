<?xml version="1.0"?>
<config>
    <modules>
        <Maho_Translations>
            <version>0.3.0</version>
        </Maho_Translations>
    </modules>
    <global>
        <models>
            <core_resource>
                <rewrite>
                    <translate>Maho_Translations_Model_Resource_Translate</translate>
                </rewrite>
            </core_resource>
            <translations>
                <class>Maho_Translations_Model</class>
                <resourceModel>translations_resource</resourceModel>
            </translations>
            <translations_resource>
                <class>Maho_Translations_Model_Resource</class>
                <entities>
                    <source>
                        <table>translation_source</table>
                    </source>
                    <location>
                        <table>translation_location</table>
                    </location>
                    <pack>
                        <table>translation_pack</table>
                    </pack>
                    <scan>
                        <table>translation_scan</table>
                    </scan>
                    <draft>
                        <table>translation_draft</table>
                    </draft>
                    <long>
                        <table>translation_long</table>
                    </long>
                </entities>
            </translations_resource>
        </models>
        <helpers>
            <translations>
                <class>Maho_Translations_Helper</class>
            </translations>
        </helpers>
        <blocks>
            <translations>
                <class>Maho_Translations_Block</class>
            </translations>
        </blocks>
        <services>
            <translations>
                <class>Maho_Translations_Service</class>
            </translations>
        </services>
    </global>
    <adminhtml>
        <translate>
            <modules>
                <Maho_Translations>
                    <files>
                        <default>Maho_Translations.csv</default>
                    </files>
                </Maho_Translations>
            </modules>
        </translate>
        <layout>
            <updates>
                <maho_translations>
                    <file>maho_translations.xml</file>
                </maho_translations>
            </updates>
        </layout>
    </adminhtml>
</config>
